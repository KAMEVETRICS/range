# Runtime environment: development, test, or production.
NODE_ENV=

# PostgreSQL connection URL for Range history.
DATABASE_URL=

# Redis connection URL for current state.
REDIS_URL=

# Comma-separated Redpanda broker addresses.
REDPANDA_BROKERS=

# Server-side pepper used to hash Range API tokens.
RANGE_API_TOKEN_PEPPER=

# Optional read-only Extended API credential.
EXTENDED_API_KEY=

# Optional Ondo Stocks API credential after provider onboarding.
ONDO_STOCKS_API_KEY=

# Optional Bitget Reality-feed read-only API credential.
BITGET_READONLY_API_KEY=

# Optional Bitget Reality-feed read-only API secret.
BITGET_READONLY_API_SECRET=

# Optional Bitget Reality-feed read-only passphrase.
BITGET_READONLY_PASSPHRASE=
