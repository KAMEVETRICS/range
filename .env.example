# Runtime environment: development, test, or production.
NODE_ENV=

# PostgreSQL connection URL for Range history.
DATABASE_URL=

# Redis connection URL for current state.
REDIS_URL=

# Comma-separated Redpanda broker addresses.
REDPANDA_BROKERS=

# Server-side pepper used to hash Range API tokens.
RANGE_API_TOKEN_PEPPER=

# Operator/verifier Range token (may include intent:create).
RANGE_DEMO_API_TOKEN=

# Distinct dashboard proxy token; gateway grants read scopes only.
RANGE_DASHBOARD_READ_TOKEN=

# Optional credential for an independently hosted, isolated fault controller.
RANGE_FAULT_CONTROL_TOKEN=

# Local MCP stdio principal and comma-separated Range scopes.
RANGE_MCP_CLIENT_ID=
RANGE_MCP_SCOPES=market:read,opportunity:read

# Required public venue capabilities for stdio; never include connector credentials.
RANGE_VENUE_MANIFEST_JSON=[{"venue":"extended","capabilities":["orderbook"],"freshnessBudgetMs":5000}]

# Optional stdio in-flight tool bound (default 16, maximum 1000).
RANGE_MCP_MAX_CONCURRENT=16

# Optional read-only Extended API credential.
EXTENDED_API_KEY=

# Optional Ondo Stocks API credential after provider onboarding.
ONDO_STOCKS_API_KEY=

# Optional Bitget Reality-feed read-only API credential.
BITGET_READONLY_API_KEY=

# Optional Bitget Reality-feed read-only API secret.
BITGET_READONLY_API_SECRET=

# Optional Bitget Reality-feed read-only passphrase.
BITGET_READONLY_PASSPHRASE=
