# Runtime environment: development, test, or production.
NODE_ENV=

# PostgreSQL connection URL for Range history.
DATABASE_URL=

# Compose Postgres/MinIO passwords; URL-safe (hex). Unset falls back to development-only values.
RANGE_POSTGRES_PASSWORD=
RANGE_MINIO_PASSWORD=

# Redis connection URL for current state.
REDIS_URL=

# Comma-separated Redpanda broker addresses.
REDPANDA_BROKERS=

# Server-side pepper used to hash Range API tokens.
RANGE_API_TOKEN_PEPPER=

# Operator/verifier Range token (may include intent:create): 32-256 characters of A-Z, a-z, 0-9, _ and -.
RANGE_DEMO_API_TOKEN=

# Distinct dashboard proxy token, same format; gateway grants read scopes only.
RANGE_DASHBOARD_READ_TOKEN=

# Distinct token for public agents, same format and read scopes only. The dashboard's proxy uses it for /mcp and for
# every /v1 call that is not the dashboard's own, so agents get their own rate-limit budget.
RANGE_PUBLIC_AGENT_TOKEN=

# Optional credential for an independently hosted, isolated fault controller.
RANGE_FAULT_CONTROL_TOKEN=

# Local MCP stdio principal and comma-separated Range scopes.
RANGE_MCP_CLIENT_ID=
RANGE_MCP_SCOPES=market:read,opportunity:read

# Required public venue capabilities for stdio; never include connector credentials.
RANGE_VENUE_MANIFEST_JSON=[{"venue":"extended","capabilities":["orderbook"],"freshnessBudgetMs":5000}]

# Optional stdio in-flight tool bound (default 16, maximum 1000).
RANGE_MCP_MAX_CONCURRENT=16

# Connectors publish the market.raw.v1 copy only when "true"; nothing reads it until the raw archive exists.
RANGE_PUBLISH_RAW_EVENTS=

# Minimum milliseconds between deliveries of one Bitget ticker / order-book channel (default 10000 each); the reviewed
# stock perpetuals' books have their own interval (default 500).
RANGE_BITGET_TICKER_INTERVAL_MS=
RANGE_BITGET_BOOK_INTERVAL_MS=
RANGE_BITGET_REVIEWED_BOOK_INTERVAL_MS=

# Hours of book and funding history Postgres keeps (default 24, and 72 under Compose; 0 keeps everything). Events cited
# by evidence are kept.
RANGE_HISTORY_RETENTION_HOURS=

# Hours of results and their evidence Postgres keeps (default 0, which keeps every result as an audit trail). Once a
# result goes, the books and funding its evidence cited age out with the rest.
RANGE_RESULT_RETENTION_HOURS=

# Optional read-only Extended API credential.
EXTENDED_API_KEY=

# Optional Ondo Stocks API credential after provider onboarding.
ONDO_STOCKS_API_KEY=

# Optional Bitget Reality-feed read-only API credential.
BITGET_READONLY_API_KEY=

# Optional Bitget Reality-feed read-only API secret.
BITGET_READONLY_API_SECRET=

# Optional Bitget Reality-feed read-only passphrase.
BITGET_READONLY_PASSPHRASE=
