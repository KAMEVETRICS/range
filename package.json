{
  "name": "range",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest --run --exclude tests/e2e/dashboard.spec.ts",
    "vitest": "vitest",
    "playwright": "playwright",
    "seed:mappings": "tsx scripts/seed-mappings.ts",
    "test:e2e": "playwright test",
    "lint": "eslint apps connectors packages scripts tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit --project tsconfig.base.json",
    "dev:compose": "docker compose -f infra/compose.yaml up"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.44.1",
    "tsx": "^4.20.0",
    "vitest": "^4.0.0"
  }
}
