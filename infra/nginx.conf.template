server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  location = /healthz { access_log off; return 200 '{"status":"healthy"}'; add_header Content-Type application/json; }
  location /v1/ {
    # Resolve the gateway through Docker's DNS on each request (cached 10 s): a recreated gateway gets a new address,
    # and a name resolved once at startup made every API call fail with 502 until nginx restarted.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $gateway_upstream http://gateway:8080;
    proxy_pass $gateway_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host gateway;
    proxy_set_header Authorization "Bearer ${RANGE_DASHBOARD_READ_TOKEN}";
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }
  location / { try_files $uri $uri/ /index.html; }
}
